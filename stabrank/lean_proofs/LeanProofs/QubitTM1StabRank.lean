import LeanProofs.ReflectQubit

set_option linter.style.longLine false

namespace StabRank

open Stabilizer

namespace QubitTM1

/-- The scalar in front of the target in `qubit_T` at `m = 1`. -/
noncomputable def scalar : ℂ := (sT : ℂ) / (2 ^ 1 * 6 ^ 0)

def x0_0 : Fin 1 → ZMod 2 := ![0]
def W0 : Fin 0 → Fin 1 → ZMod 2 := ![]
def Q0 : Fin 0 → Fin 0 → ZMod 2 := ![]
def l0 : Fin 0 → ZMod (stabPeriod 2) := ![]
def piv0 : Fin 0 → Fin 1 := ![]
theorem piv0_ok : ∀ j j', W0 j (piv0 j') = if j = j' then 1 else 0 := by
  decide +kernel
noncomputable def t0 : Fin (2 ^ 1) → ℂ := stabTerm 2 1 0 x0_0 W0 Q0 l0
theorem t0_isStab : IsStabP 2 t0 :=
  isStabP_stabTerm 2 1 0 _ _ _ _ (affinePtP_injective_of_pivots _ _ piv0 piv0_ok)
def C0 : Fin 8 → ℤ := ![0, 1, 0, 1, 0, 0, 0, 0]

def x0_1 : Fin 1 → ZMod 2 := ![1]
def W1 : Fin 0 → Fin 1 → ZMod 2 := ![]
def Q1 : Fin 0 → Fin 0 → ZMod 2 := ![]
def l1 : Fin 0 → ZMod (stabPeriod 2) := ![]
def piv1 : Fin 0 → Fin 1 := ![]
theorem piv1_ok : ∀ j j', W1 j (piv1 j') = if j = j' then 1 else 0 := by
  decide +kernel
