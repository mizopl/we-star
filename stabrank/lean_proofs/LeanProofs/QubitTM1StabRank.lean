  ![t0, t1]
def Cs : Fin 2 → Fin 8 → ℤ := ![C0, C1]

theorem terms_isStab : ∀ j, IsStabP 2 (terms j) := by
  intro j
  fin_cases j
  exacts [t0_isStab, t1_isStab]

set_option linter.unusedSimpArgs false in
theorem target_eq : tVec 1 = ∑ j, (scalar * ev B8 (Cs j)) • terms j := by
  funext idx
  have hk := congrArg (ev B8) (key idx)
  rw [ev_zsmul] at hk
  simp only [rhsZ, ev_add, Den, Int.cast_one, Int.cast_ofNat, one_mul, ev_termZ B8 MI8_represents piv0_ok, ev_termZ B8 MI8_represents piv1_ok] at hk
  have ht : tVec 1 idx = scalar * ev B8 (tgtT 1 (digitsP 2 1 idx)) := by
    have h := tVec_eq_ev 1 idx
    try simp only [Nat.reduceMod, Nat.reduceDiv, pow_zero, pow_one] at h
    unfold scalar
    linear_combination h
  rw [Finset.sum_apply, ht]
  simp only [Pi.smul_apply, smul_eq_mul, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero,
    Matrix.cons_val_succ, add_zero, terms, Cs, t0, t1, stabTerm]
