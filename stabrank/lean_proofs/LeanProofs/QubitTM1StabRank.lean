def Den : ℤ := 1

/-- The integer side of `Σ_j C_j · σ_j` at a digit string. -/
def rhsZ (x : Fin 1 → ZMod 2) : Fin 8 → ℤ :=
  termZ MI8 C0 x0_0 W0 Q0 l0 piv0 x
    + termZ MI8 C1 x0_1 W1 Q1 l1 piv1 x

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- The identity on integer vectors, decided by the kernel at every index. -/
theorem key : ∀ idx : Fin (2 ^ 1), Den • tgtT 1 (digitsP 2 1 idx) = rhsZ (digitsP 2 1 idx) := by
  decide +kernel

