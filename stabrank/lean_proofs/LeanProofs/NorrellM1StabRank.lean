/-
`χ(|N⟩^⊗1) ≤ 2` against `stabRankP 3`, from the witness of
`bounds/N-m1-upper-2.json`.

Generated by `lean_proofs/tools/gen_witness_lean.py`; do not edit by hand. The
terms are the file's, entered as `stabTerm 3 1 k x0 W Q l` with the pivot
columns of `W` (`Q` is read as an upper-triangular form, as the verifier reads
it). Each coefficient is the integer vector `Cj` in the basis `B3` of
`LeanProofs/ReflectQutrit.lean`: the file's coefficient, divided by the
`√3^k` normalisation of its term and by the common scalar in front of the
target (`norrellVec_eq_ev`), times `Den = 1`. The pointwise identity is
decided by the kernel on integer vectors at all 3 digit strings (`key`) and
carried to `ℂ` by `ev_termZ`.
-/
import LeanProofs.ReflectQutrit

set_option linter.style.longLine false

namespace StabRank

open Stabilizer

namespace NorrellM1

/-- The scalar in front of the target in `N` at `m = 1`. -/
noncomputable def scalar : ℂ := ((Real.sqrt 2 : ℂ) * (Real.sqrt 3 : ℂ) / 6) ^ 1

def x0_0 : Fin 1 → ZMod 3 := ![2]
def W0 : Fin 0 → Fin 1 → ZMod 3 := ![]
def Q0 : Fin 0 → Fin 0 → ZMod 3 := ![]
def l0 : Fin 0 → ZMod (stabPeriod 3) := ![]
def piv0 : Fin 0 → Fin 1 := ![]
theorem piv0_ok : ∀ j j', W0 j (piv0 j') = if j = j' then 1 else 0 := by
  decide +kernel
noncomputable def t0 : Fin (3 ^ 1) → ℂ := stabTerm 3 1 0 x0_0 W0 Q0 l0
theorem t0_isStab : IsStabP 3 t0 :=
  isStabP_stabTerm 3 1 0 _ _ _ _ (affinePtP_injective_of_pivots _ _ piv0 piv0_ok)
def C0 : Fin 4 → ℤ := ![(-3), 0, 0, 0]

def x0_1 : Fin 1 → ZMod 3 := ![0]
def W1 : Fin 1 → Fin 1 → ZMod 3 := ![![1]]
def Q1 : Fin 1 → Fin 1 → ZMod 3 := ![![0]]
def l1 : Fin 1 → ZMod (stabPeriod 3) := ![0]
def piv1 : Fin 1 → Fin 1 := ![0]
theorem piv1_ok : ∀ j j', W1 j (piv1 j') = if j = j' then 1 else 0 := by
  decide +kernel
noncomputable def t1 : Fin (3 ^ 1) → ℂ := stabTerm 3 1 1 x0_1 W1 Q1 l1
theorem t1_isStab : IsStabP 3 t1 :=
  isStabP_stabTerm 3 1 1 _ _ _ _ (affinePtP_injective_of_pivots _ _ piv1 piv1_ok)
def C1 : Fin 4 → ℤ := ![1, 0, 0, 0]

def Den : ℤ := 1

/-- The integer side of `Σ_j C_j · σ_j` at a digit string. -/
def rhsZ (x : Fin 1 → ZMod 3) : Fin 4 → ℤ :=
  termZ Mw3 C0 x0_0 W0 Q0 l0 piv0 x
    + termZ Mw3 C1 x0_1 W1 Q1 l1 piv1 x

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- The identity on integer vectors, decided by the kernel at every index. -/
theorem key : ∀ idx : Fin (3 ^ 1), Den • tgtN 1 (digitsP 3 1 idx) = rhsZ (digitsP 3 1 idx) := by
  decide +kernel

noncomputable def terms : Fin 2 → (Fin (3 ^ 1) → ℂ) :=
  ![t0, t1]
def Cs : Fin 2 → Fin 4 → ℤ := ![C0, C1]

theorem terms_isStab : ∀ j, IsStabP 3 (terms j) := by
  intro j
  fin_cases j
  exacts [t0_isStab, t1_isStab]

set_option linter.unusedSimpArgs false in
theorem target_eq : norrellVec 1 = ∑ j, (scalar * ev B3 (Cs j)) • terms j := by
  funext idx
  have hk := congrArg (ev B3) (key idx)
  rw [ev_zsmul] at hk
  simp only [rhsZ, ev_add, Den, Int.cast_one, Int.cast_ofNat, one_mul, ev_termZ B3 Mw3_represents piv0_ok, ev_termZ B3 Mw3_represents piv1_ok] at hk
  have ht : norrellVec 1 idx = scalar * ev B3 (tgtN 1 (digitsP 3 1 idx)) := by
    have h := norrellVec_eq_ev 1 idx
    try simp only [Nat.reduceMod, Nat.reduceDiv, pow_zero, pow_one] at h
    unfold scalar
    linear_combination h
  rw [Finset.sum_apply, ht]
  simp only [Pi.smul_apply, smul_eq_mul, Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero,
    Matrix.cons_val_succ, add_zero, terms, Cs, t0, t1, stabTerm]
  linear_combination scalar * hk

end NorrellM1

/-- **χ(|N⟩^⊗1) ≤ 2 against `IsStabP 3`.** -/
theorem norrell_m1_stabRankP_le_two : stabRankP 3 (norrellVec 1) ≤ 2 :=
  stabRankP_le_of_terms 3 NorrellM1.terms _ NorrellM1.terms_isStab NorrellM1.target_eq

/-- The same bound against the qutrit predicate `IsStab`. -/
theorem norrell_m1_stabRank_le_two : Stabilizer.stabRank (IsStab (n := 1)) (norrellVec 1) ≤ 2 := by
  rw [stabRank_eq_stabRankP]
  exact norrell_m1_stabRankP_le_two

end StabRank
